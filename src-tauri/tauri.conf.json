{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Advisor",
  "version": "0.2.3",
  "identifier": "dev.yoel3imari.llm-advisor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LLM Advisor",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/yoel3imari/llm-advisor/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDNzM4MkIyQzJDRjU5M0IKUldRN1djL0Nzb0p6dkhoeWpJMkZBS0RROXJUcUpaZnRBZ2ZVdWxhb0g4Rk5DY1Y3dCtxNGY2ZjYK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/*"
    ],
    "externalBin": [
      "binaries/llama-server"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-common",
          "libssl3 | libssl1.1"
        ]
      },
      "rpm": {
        "depends": [
          "libwebkit2gtk-4.1.so.0()(64bit)",
          "libgtk-3.so.0()(64bit)",
          "libayatana-appindicator3.so.1()(64bit)",
          "librsvg-2.so.2()(64bit)",
          "libssl.so.3()(64bit)",
          "libcrypto.so.3()(64bit)"
        ]
      }
    }
  }
}
