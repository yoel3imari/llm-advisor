{
  "name": "llm-advisor",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:bundle": "LD_LIBRARY_PATH=\"$(pwd)/src-tauri/binaries:${LD_LIBRARY_PATH:-}\" tauri build && bash ./scripts/post-bundle.sh",
    "build:deb": "tauri build -b deb",
    "build:appimage": "LD_LIBRARY_PATH=\"$(pwd)/src-tauri/binaries:${LD_LIBRARY_PATH:-}\" tauri build -b appimage",
    "preview": "vite preview",
    "tauri": "LD_LIBRARY_PATH=\"$(pwd)/src-tauri/binaries:${LD_LIBRARY_PATH:-}\" tauri",
    "doctor": "bash ./scripts/doctor.sh",
    "sidecar:fetch": "bash ./scripts/fetch-sidecar.sh",
    "demo": "bash ./demo/serve.sh 3333",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
